# Copy to .env.local. One file configures the web app and the API (they run as one server).
# Local database: `npm run db:up` (PostgreSQL + PostGIS on port 54329)
DATABASE_URL=postgres://sanflow:sanflow@127.0.0.1:54329/sanflow
# Set true for managed Postgres that requires TLS (Neon / Supabase / RDS)
DATABASE_SSL=false
# 32+ random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
# PORT=3000
# Only if the web app is hosted separately from the API:
# NEXT_PUBLIC_API_URL=https://api.example.org
# CORS_ORIGIN=https://app.example.org
# API-only host (pages are on Netlify): API_ONLY=true
